# Secrets — never commit
.env
.env.*
!.env.example

# Derived artifacts — regenerable from raw/ + wiki/ + ontology/
# parser cache (regenerated by document_parser.py)
parsed/
# context graph (regenerated by compile_graph.py)
graph/
# SQLite FTS index (regenerated by build_kb_index.py)
kb/

# Large model assets that don't belong in source control
# Tesseract English OCR weights (~5 MB)
eng.traineddata

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
venv/
*.egg-info/

# OS / editor / IDE
.DS_Store
.idea/
.vscode/
# local Claude Code state
.claude/

# Logs / runtime crumbs
*.log
/tmp/
