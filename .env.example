# Copy to .env and fill in real keys. .env is gitignored; this file is a template.

LLM_PROVIDER=moonshot
KIMI_TEMPERATURE=1

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
# OPENAI_TEMPERATURE=
# OPENAI_REASONING_EFFORT=none

# Moonshot (Kimi K2.6)
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k2.6
MOONSHOT_TEMPERATURE=0.6   # Required when K2.6 thinking is disabled for tool-call compatibility

# OpenRouter (Nemotron 3 Nano Omni — free tier)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
# OPENROUTER_HTTP_REFERER=
# OPENROUTER_X_TITLE=

# NVIDIA Nemotron 3 Nano (direct via build.nvidia.com OpenAI-compatible endpoint)
# Reuses NVIDIA_API_KEY from the document parser section below.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-nano-3

# DeepSeek V4
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4

# Google Gemini
GEMINI_API_KEY=
# GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3-pro-preview
# GEMINI_TEMPERATURE=

# Document parsing
# liteparse: local PDF parsing with layout, OCR, and bounding boxes.
# landingai: ADE Parse API with chunks, grounding, tables, and confidence scores.
# nemotron: NVIDIA Nemotron Parse via optional paper-qa-nemotron package.
DOCUMENT_PARSER_PROVIDER=liteparse
DOCUMENT_PARSER_TIMEOUT=180
DOCUMENT_PARSER_PDF_PASSWORD=

# LiteParse. Requires Node.js >=18 and the @llamaindex/liteparse CLI.
LITEPARSE_CLI_PATH=
LITEPARSE_INSTALL_IF_MISSING=false
LITEPARSE_OCR_ENABLED=false
LITEPARSE_OCR_SERVER_URL=
LITEPARSE_OCR_LANGUAGE=en
LITEPARSE_DPI=150
LITEPARSE_TARGET_PAGES=

# LandingAI ADE Parse
LANDINGAI_API_KEY=
LANDINGAI_PARSE_URL=https://api.va.landing.ai/v1/ade/parse
LANDINGAI_PARSE_MODEL=dpt-2-latest
# LANDINGAI_SPLIT=page

# Nemotron Parse
NVIDIA_API_KEY=
